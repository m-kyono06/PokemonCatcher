@@ -0,0 +1,103 @@
+package me.magnum.melonds.ui.emulator.lua
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Rect
+import android.view.View
+import org.json.JSONObject
+
+internal data class Encounters(val location: String, val groups: List<Group>) {
+    data class Group(val label: String, val species: List<Int>)
+
+    companion object {
+        const val PREFIX = "PokemonCatcher sidebar:"
+
+        fun parse(payload: String): Encounters? = runCatching {
+            val data = JSONObject(payload)
+            val groups = data.getJSONArray("groups")
+            require(groups.length() <= 10)
+            Encounters(data.getString("location").take(60), List(groups.length()) { index ->
+                val group = groups.getJSONArray(index)
+                require(group.length() in 2..494)
+                Group(group.getString(0).take(24), List(group.length() - 1) {
+                    group.getInt(it + 1).also { species -> require(species in 1..493) }
+                })
+            })
+        }.getOrNull()
+    }
+}
+
+class EncounterSidebar(context: Context, attrs: android.util.AttributeSet? = null) : View(context, attrs) {
+    internal var encounters: Encounters? = null
+        set(value) { field = value; invalidate() }
+    var atlas: Bitmap? = null
+        set(value) { field = value; invalidate() }
+    var topScreen: Rect? = null
+        set(value) { field = value; invalidate() }
+    var bottomScreen: Rect? = null
+        set(value) { field = value; invalidate() }
+
+    private val text = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE }
+    private val pixels = Paint().apply { isFilterBitmap = false }
+    private val source = Rect()
+    private val target = Rect()
+
+    override fun onDraw(canvas: Canvas) {
+        val data = encounters ?: return
+        val top = topScreen ?: return
+        val artwork = atlas ?: return
+        val left = Rect(0, maxOf(0, top.top), top.left.coerceIn(0, width), minOf(height, top.bottom))
+        val right = Rect(top.right.coerceIn(0, width), left.top, width, left.bottom)
+        val bottom = bottomScreen
+        val dry = data.groups.filterNot { it.label.contains("つりざお") || it.label == "なみのり" }
+        val wet = data.groups.filter { it !in dry }
+        val leftAvailable = left.width() >= 12 && left.height() >= 12 && (bottom == null || !Rect.intersects(left, bottom))
+        val rightAvailable = right.width() >= 12 && right.height() >= 12 && (bottom == null || !Rect.intersects(right, bottom))
+        if (leftAvailable) drawPanel(canvas, left, data.location, if (rightAvailable) dry else data.groups, artwork)
+        if (rightAvailable) drawPanel(canvas, right, if (leftAvailable) "" else data.location, if (leftAvailable) wet else data.groups, artwork)
+    }
+
+    private fun drawPanel(canvas: Canvas, area: Rect, location: String, groups: List<Encounters.Group>, artwork: Bitmap) {
+        val padding = minOf(8, area.width() / 8)
+        val usable = area.width() - padding * 2
+        val titleRows = groups.size + if (location.isEmpty()) 0 else 1
+        val maxCell = minOf(64, usable)
+        val cell = (maxCell downTo 1).firstOrNull { size ->
+            val columns = usable / size
+            val iconRows = groups.sumOf { (it.species.size + columns - 1) / columns }
+            padding * 2 + titleRows * (size / 2 + 3) + iconRows * size <= area.height()
+        } ?: return
+        val columns = usable / cell
+        val headingHeight = cell / 2 + 3
+        val x = area.left + padding
+        var y = area.top + padding
+        canvas.save()
+        canvas.clipRect(area)
+        fun heading(value: String) {
+            text.textSize = maxOf(1f, headingHeight - 3f)
+            val measured = text.measureText(value)
+            if (measured > usable) text.textSize *= usable / measured
+            canvas.drawText(value, x.toFloat(), y - text.ascent(), text)
+            y += headingHeight
+        }
+        if (location.isNotEmpty()) heading(location)
+        for ((label, species) in groups) {
+            heading(label)
+            species.forEachIndexed { index, id ->
+                val tile = id - 1
+                val sx = tile % 16 * 32
+                val sy = tile / 16 * 32
+                source.set(sx, sy, sx + 32, sy + 32)
+                val dx = x + index % columns * cell
+                val dy = y + index / columns * cell
+                target.set(dx, dy, dx + cell, dy + cell)
+                canvas.drawBitmap(artwork, source, target, pixels)
+            }
+            y += (species.size + columns - 1) / columns * cell
+        }
+        canvas.restore()
+    }
+}
